{
  "mcpServers": {
    "fireraccoon": {
      "command": "dart",
      "args": [
        "run",
        "packages/mcp/bin/fireraccoon_mcp.dart"
      ],
      "env": {
        "FIRERACCOON_URL": "https://fireraccoon.example",
        "FIRERACCOON_API_KEY": "frcn_YOUR_AGENT_KEY"
      }
    }
  }
}
