#!/usr/bin/env bash
#
# Pre-commit hook — mirrors CI lint/test gate locally.
# Enable with: bash tool/setup-hooks.sh

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

section() {
  printf '\n\033[1;34m==> %s\033[0m\n' "$1"
}

fail() {
  printf '\n\033[1;31m✗ pre-commit failed: %s\033[0m\n' "$1" >&2
  exit 1
}

SRC_DIRS="lib test packages/engine/lib packages/engine/test packages/mcp/lib packages/mcp/bin packages/mcp/test packages/app_backend/lib packages/app_backend/bin packages/app_backend/test"

section "1/5  Prepare CI environment"
bash tool/setup-ci-env.sh

section "2/5  dart format (check only)"
# shellcheck disable=SC2086
dart format --output=none --set-exit-if-changed $SRC_DIRS \
  || fail "code is not formatted — run 'dart format $SRC_DIRS'"

section "3/5  analyze"
# Each package resolves its own dev_dependencies. The root config carries none
# of them, and relying on one leaking in through the app's own dev chain broke
# the moment that chain changed.
( cd packages/engine && dart pub get ) || fail "engine pub get failed"
( cd packages/mcp && dart pub get ) || fail "mcp pub get failed"
( cd packages/app_backend && dart pub get ) || fail "app_backend pub get failed"
dart analyze packages/engine packages/mcp packages/app_backend \
  || fail "dart analyze reported issues"
flutter analyze || fail "flutter analyze reported issues"

section "4/5  tests"
# Stale coverage first. format_coverage aggregates whatever sits in these
# directories, and a hit map written against another tree's line numbers lands
# its hits on the wrong lines, so an edited package reports far less coverage
# than it has and fails its floor on a commit that touched nothing in it. A map
# belonging to a test file that has since been deleted lingers the same way.
# Seen twice now: MCP read 76.4% against a 99% floor, and 99.1% on a clean run.
rm -rf packages/engine/coverage packages/mcp/coverage \
  packages/app_backend/coverage coverage

# Password handling derives a key per call, 600k PBKDF2 rounds. A test doing
# several, instrumented for coverage and competing with the other isolates,
# crosses the 30s default and fails on load rather than on what it asserts.
( cd packages/engine && dart test --coverage=coverage --timeout 3x ) \
  || fail "engine tests failed"
( cd packages/mcp && dart test --coverage=coverage --timeout 3x ) \
  || fail "mcp tests failed"
( cd packages/app_backend && dart test --coverage=coverage --timeout 3x ) \
  || fail "app_backend tests failed"
flutter test --coverage --timeout 3x || fail "flutter tests failed"

section "5/5  coverage gate"
chmod +x tool/check_coverage.sh
./tool/check_coverage.sh || fail "coverage gate failed"

printf '\n\033[1;32m✓ pre-commit passed\033[0m\n'
