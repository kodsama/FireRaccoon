# Local secrets (copy from .env.example)
.env

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/build/
**/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local one-off scripts (not part of the product)
scratch_*.py

# Local Firefly volume archives from tool/firefly_backup.sh
/backups/

# Global gitignores often drop every `bin/` directory; keep package entrypoints.
!packages/mcp/bin/
!packages/mcp/bin/**
!packages/app_backend/bin/
!packages/app_backend/bin/**

# Global macOS `Icon?` (custom folder icon) matches the `icons/` directory on
# case-insensitive volumes. Keep Flutter web PWA / splash icons tracked.
!web/icons/
!web/icons/**
