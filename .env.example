# FireRacoon local development credential fallback.
#
# Copy this file to `.env` and fill in your values. The `.env` file is
# gitignored and is ONLY read on DEBUG desktop builds via dart:io — it is never
# bundled as a Flutter asset, so it can never appear in a published web build.
#
# In release builds and on web this file is ignored entirely; credentials there
# live exclusively in platform secure storage (Keychain / encrypted browser
# storage), entered through Settings.

FIREFLY_URL=https://your-firefly.example.com
FIREFLY_TOKEN=your-personal-access-token

# Optional: allow plain http:// connections (default: false).
FIREFLY_ALLOW_INSECURE=false
